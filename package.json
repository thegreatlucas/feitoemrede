{
  "name": "feitoemrede",
  "version": "1.0.0",
  "description": "Uma plataforma para aproximar consumidores de empreendedores progressistas e conectar pessoas a oportunidades de trabalho.",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "node --use-env-proxy node_modules/next/dist/bin/next build --webpack",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib tests proxy.ts next.config.ts tsconfig.json package.json README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thegreatlucas/feitoemrede.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/thegreatlucas/feitoemrede/issues"
  },
  "homepage": "https://github.com/thegreatlucas/feitoemrede#readme",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.5 <25"
  }
}
